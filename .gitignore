# Ansible runtime artifacts
*.retry
.ansible/

# Local state we don't want committed
cluster-internal-ca.crt
k3s_token.txt

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local tooling caches
__pycache__/
*.pyc

# Dev Container state (none currently, but reserved)
.devcontainer/.cache/

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl.bak
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/crash.*.log
# NOTE: terraform.tfvars IS committed (VM definitions are not secret).
# NOTE: terraform/.terraform.lock.hcl IS committed (provider version lock).
